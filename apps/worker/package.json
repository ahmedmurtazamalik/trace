{
  "name": "@trace/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-latex-templates.mjs",
    "start": "node --env-file-if-exists=../../.env dist/src/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage"
  },
  "dependencies": {
    "@trace/database": "workspace:*",
    "@trace/report-storage": "workspace:*",
    "@trace/shared": "workspace:*",
    "bullmq": "6.1.0",
    "pdf-lib": "^1.17.1",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "22.18.0",
    "jest": "29.7.0",
    "ts-jest": "29.4.12",
    "typescript": "5.9.2"
  }
}
