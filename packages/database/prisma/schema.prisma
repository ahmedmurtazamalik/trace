generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GithubAccountType {
  USER
  ORGANIZATION
}

enum ActivitySource {
  github
  cli
}

enum ActivityType {
  commit
  push
  pull_request
  working_tree_snapshot
  staged_change
  untracked_file
  local_commit
}

enum ReportStatus {
  pending
  processing
  completed
  failed
}

enum ReportRevisionSource {
  ai
  manual
}

enum ReportArtifactKind {
  latex
  pdf
}

enum WorkspaceRole {
  MANAGER
  DEVELOPER
}

enum WorkspaceAnalysisStatus {
  UNINITIALIZED
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  BLOCKED_ACCESS
}

enum WorkspaceAnalysisRunKind {
  BASELINE
  INCREMENTAL
}

enum WorkspaceAnalysisAccessState {
  ACTIVE
  ACCESS_REMOVED
}

enum WorkspaceReportFrequency {
  DAILY
  WEEKDAYS
  SELECTED_DAYS
}

enum WorkspaceReportTrigger {
  MANUAL
  SCHEDULED
  RECOVERY
}

enum WorkspaceReportOccurrenceStatus {
  PENDING
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum WebhookDeliveryStatus {
  pending
  processing
  completed
  failed
}

model User {
  id                  String               @id @default(cuid())
  username            String               @unique @db.VarChar(39)
  displayName         String?              @map("display_name") @db.VarChar(100)
  email               String?              @unique @db.VarChar(254)
  passwordHash        String               @map("password_hash")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  disabledAt          DateTime?            @map("disabled_at")
  sessions            UserSession[]
  passwordResetTokens PasswordResetToken[]
  githubAccount       GithubAccount?
  githubOauthStates   GithubOauthState[]
  repositories        UserRepository[]
  reports             Report[]
  auditLogs            AuditLog[]
  createdWorkspaces   Workspace[]           @relation("WorkspaceCreator")
  workspaceMemberships WorkspaceMembership[]
  workspaceRepositoryAssignments WorkspaceRepository[] @relation("WorkspaceRepositoryAssigner")
  configuredWorkspaceReportSchedules WorkspaceReportSchedule[] @relation("WorkspaceReportScheduleConfigurer")
  requestedWorkspaceReportOccurrences WorkspaceReportOccurrence[] @relation("WorkspaceReportOccurrenceRequester")

  @@map("users")
}

model UserSession {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  sessionTokenHash String    @unique @map("session_token_hash")
  csrfTokenHash    String    @unique @map("csrf_token_hash")
  createdAt        DateTime  @default(now()) @map("created_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  lastUsedAt       DateTime  @default(now()) @map("last_used_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  githubOauthStates GithubOauthState[]

  @@index([userId, expiresAt])
  @@map("user_sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model GithubAccount {
  id             String               @id @default(cuid())
  userId         String               @unique @map("user_id")
  githubUserId   BigInt               @unique @map("github_user_id")
  githubUsername String               @map("github_username")
  displayName    String?              @map("display_name")
  avatarUrl      String?              @map("avatar_url")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  unlinkedAt     DateTime?            @map("unlinked_at")
  user           User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  installations  GithubInstallation[]

  @@map("github_accounts")
}

model GithubInstallation {
  id                   String            @id @default(cuid())
  githubInstallationId BigInt            @unique @map("github_installation_id")
  githubAccountId      String            @map("github_account_id")
  accountType          GithubAccountType @map("account_type")
  accountLogin         String            @map("account_login")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  suspendedAt          DateTime?         @map("suspended_at")
  syncGeneration       Int               @default(0) @map("sync_generation")
  githubAccount        GithubAccount     @relation(fields: [githubAccountId], references: [id], onDelete: Restrict)
  repositories         Repository[]
  webhookDeliveries    GithubWebhookDelivery[]

  @@index([githubAccountId, suspendedAt])
  @@map("github_installations")
}

model Repository {
  id                 String                    @id @default(cuid())
  githubRepositoryId BigInt                    @unique @map("github_repository_id")
  githubInstallationId String                  @map("github_installation_id")
  owner              String
  name               String
  fullName           String                    @map("full_name")
  private            Boolean
  defaultBranch      String                    @map("default_branch")
  htmlUrl            String?                   @map("html_url")
  accessRemovedAt     DateTime?                 @map("access_removed_at")
  lastSyncSequence    BigInt                    @default(0) @map("last_sync_sequence")
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")
  installation       GithubInstallation        @relation(fields: [githubInstallationId], references: [id], onDelete: Restrict)
  users              UserRepository[]
  commits            Commit[]
  pushEvents         PushEvent[]
  activityEvents     ActivityEvent[]
  webhookDeliveries  GithubWebhookDelivery[]
  workspaces         WorkspaceRepository[]
  workspaceAnalysisStates WorkspaceRepositoryAnalysis[]
  workspaceAnalysisRuns WorkspaceAnalysisRun[]

  @@index([githubInstallationId])
  @@index([githubInstallationId, accessRemovedAt])
  @@index([owner, name])
  @@map("repositories")
}

model UserRepository {
  id              String     @id @default(cuid())
  userId          String     @map("user_id")
  repositoryId    String     @map("repository_id")
  trackingEnabled Boolean    @default(false) @map("tracking_enabled")
  accessRemovedAt DateTime?  @map("access_removed_at")
  removedAt       DateTime?  @map("removed_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository      Repository @relation(fields: [repositoryId], references: [id], onDelete: Restrict)

  @@unique([userId, repositoryId])
  @@index([userId, trackingEnabled])
  @@index([userId, removedAt])
  @@map("user_repositories")
}

model Workspace {
  id           String                @id @default(cuid())
  name         String                @db.VarChar(100)
  slug         String                @unique @db.VarChar(120)
  createdById  String                @map("created_by_id")
  archivedAt   DateTime?             @map("archived_at")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")
  createdBy    User                  @relation("WorkspaceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  memberships  WorkspaceMembership[]
  repositories WorkspaceRepository[]
  analysisStates WorkspaceRepositoryAnalysis[]
  analysisRuns WorkspaceAnalysisRun[]
  reportSchedule WorkspaceReportSchedule?
  reportOccurrences WorkspaceReportOccurrence[]
  reports Report[]

  @@index([createdById])
  @@index([archivedAt, createdAt])
  @@map("workspaces")
}

model WorkspaceMembership {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspace_id")
  userId      String        @map("user_id")
  role        WorkspaceRole
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, userId])
  @@index([userId, role])
  @@index([workspaceId, role])
  @@map("workspace_memberships")
}

model WorkspaceRepository {
  id           String     @id @default(cuid())
  workspaceId  String     @map("workspace_id")
  repositoryId String     @map("repository_id")
  assignedById String     @map("assigned_by_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Restrict)
  assignedBy   User       @relation("WorkspaceRepositoryAssigner", fields: [assignedById], references: [id], onDelete: Restrict)

  @@unique([workspaceId, repositoryId])
  @@index([repositoryId])
  @@index([assignedById])
  @@map("workspace_repositories")
}

model WorkspaceRepositoryAnalysis {
  id                  String                       @id @default(cuid())
  workspaceId         String                       @map("workspace_id")
  repositoryId        String                       @map("repository_id")
  status              WorkspaceAnalysisStatus      @default(UNINITIALIZED)
  baselineSha         String?                      @db.VarChar(64) @map("baseline_sha")
  lastAnalyzedSha     String?                      @db.VarChar(64) @map("last_analyzed_sha")
  baselineStartedAt   DateTime?                    @map("baseline_started_at")
  baselineCompletedAt DateTime?                    @map("baseline_completed_at")
  lastAnalyzedAt      DateTime?                    @map("last_analyzed_at")
  accessState         WorkspaceAnalysisAccessState @default(ACTIVE) @map("access_state")
  coverage            Json?
  lastError           String?                      @db.VarChar(500) @map("last_error")
  createdAt           DateTime                     @default(now()) @map("created_at")
  updatedAt           DateTime                     @updatedAt @map("updated_at")
  workspace           Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repository          Repository                   @relation(fields: [repositoryId], references: [id], onDelete: Restrict)
  runs                 WorkspaceAnalysisRun[]

  @@unique([workspaceId, repositoryId])
  @@index([workspaceId, status])
  @@index([repositoryId, accessState])
  @@map("workspace_repository_analyses")
}

model WorkspaceAnalysisRun {
  id            String                       @id @default(cuid())
  analysisId    String                       @map("analysis_id")
  workspaceId   String                       @map("workspace_id")
  repositoryId  String                       @map("repository_id")
  kind          WorkspaceAnalysisRunKind
  fromSha       String?                      @db.VarChar(64) @map("from_sha")
  toSha         String?                      @db.VarChar(64) @map("to_sha")
  dataCutoffAt  DateTime                     @map("data_cutoff_at")
  status        WorkspaceAnalysisStatus
  accessState   WorkspaceAnalysisAccessState @default(ACTIVE) @map("access_state")
  coverage      Json?
  evidence      Json                         @default("{}")
  publishedAt   DateTime?                    @map("published_at")
  processingToken String?                    @map("processing_token")
  processingExpiresAt DateTime?              @map("processing_expires_at")
  startedAt     DateTime?                    @map("started_at")
  completedAt   DateTime?                    @map("completed_at")
  error         String?                      @db.VarChar(500)
  createdAt     DateTime                     @default(now()) @map("created_at")
  analysis      WorkspaceRepositoryAnalysis  @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  workspace     Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repository    Repository                   @relation(fields: [repositoryId], references: [id], onDelete: Restrict)

  @@unique([analysisId, kind, toSha])
  @@index([workspaceId, createdAt])
  @@index([repositoryId, dataCutoffAt])
  @@index([status, createdAt])
  @@index([status, processingExpiresAt])
  @@map("workspace_analysis_runs")
}

model WorkspaceReportSchedule {
  id              String                   @id @default(cuid())
  workspaceId     String                   @unique @map("workspace_id")
  enabled         Boolean                  @default(true)
  frequency       WorkspaceReportFrequency
  selectedDays    Int[]                    @default([]) @map("selected_days")
  localTime       String                   @db.VarChar(5) @map("local_time")
  timezone        String                   @db.VarChar(100)
  version         Int                      @default(1)
  configuredById  String                   @map("configured_by_id")
  nextRunAt       DateTime?                @map("next_run_at")
  lastEvaluatedAt DateTime?                @map("last_evaluated_at")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")
  workspace       Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  configuredBy    User                     @relation("WorkspaceReportScheduleConfigurer", fields: [configuredById], references: [id], onDelete: Restrict)
  occurrences     WorkspaceReportOccurrence[]

  @@index([enabled, nextRunAt])
  @@map("workspace_report_schedules")
}

model WorkspaceReportOccurrence {
  id                    String                           @id @default(cuid())
  workspaceId           String                           @map("workspace_id")
  scheduleId            String?                          @map("schedule_id")
  scheduleVersion       Int?                             @map("schedule_version")
  trigger               WorkspaceReportTrigger
  scheduledFor          DateTime?                        @map("scheduled_for")
  intendedLocalDateTime String?                          @db.VarChar(40) @map("intended_local_date_time")
  windowStart           DateTime                         @map("window_start")
  windowEnd             DateTime                         @map("window_end")
  dataCutoffAt          DateTime                         @map("data_cutoff_at")
  requestedById         String                           @map("requested_by_id")
  status                WorkspaceReportOccurrenceStatus  @default(PENDING)
  reportId              String?                          @unique @map("report_id")
  idempotencyKey        String                           @db.VarChar(160) @map("idempotency_key")
  evidenceSnapshot      Json                             @map("evidence_snapshot")
  noActivity            Boolean?                         @map("no_activity")
  recoveredAt           DateTime?                        @map("recovered_at")
  publishedAt           DateTime?                        @map("published_at")
  createdAt             DateTime                         @default(now()) @map("created_at")
  startedAt             DateTime?                        @map("started_at")
  completedAt           DateTime?                        @map("completed_at")
  error                 String?                          @db.VarChar(500)
  workspace             Workspace                        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  schedule              WorkspaceReportSchedule?         @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  requestedBy           User                             @relation("WorkspaceReportOccurrenceRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  report                Report?                          @relation(fields: [reportId], references: [id], onDelete: NoAction)

  @@unique([workspaceId, idempotencyKey])
  @@unique([scheduleId, scheduledFor])
  @@index([status, publishedAt, createdAt])
  @@index([workspaceId, createdAt])
  @@map("workspace_report_occurrences")
}

model Contributor {
  id               String          @id @default(cuid())
  githubUserId     BigInt?         @unique @map("github_user_id")
  username         String?
  displayName      String?         @map("display_name")
  avatarUrl        String?         @map("avatar_url")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  authoredCommits  Commit[]        @relation("CommitAuthor")
  committedCommits Commit[]        @relation("CommitCommitter")
  sentPushes       PushEvent[]
  activityEvents   ActivityEvent[]

  @@index([username])
  @@map("contributors")
}

model Commit {
  id                     String       @id @default(cuid())
  repositoryId           String       @map("repository_id")
  sha                    String       @db.VarChar(64)
  message                String
  authorName             String       @map("author_name")
  authorEmail            String       @map("author_email")
  authorUsername         String?      @map("author_username")
  committerName          String       @map("committer_name")
  committerEmail         String       @map("committer_email")
  committerUsername      String?      @map("committer_username")
  authorContributorId    String?      @map("author_contributor_id")
  committerContributorId String?      @map("committer_contributor_id")
  authoredAt             DateTime     @map("authored_at")
  committedAt            DateTime     @map("committed_at")
  branch                 String?
  additions              Int?
  deletions              Int?
  changedFiles           Int?         @map("changed_files")
  createdAt              DateTime     @default(now()) @map("created_at")
  repository             Repository   @relation(fields: [repositoryId], references: [id], onDelete: Restrict)
  authorContributor      Contributor? @relation("CommitAuthor", fields: [authorContributorId], references: [id], onDelete: SetNull)
  committerContributor   Contributor? @relation("CommitCommitter", fields: [committerContributorId], references: [id], onDelete: SetNull)
  files                  CommitFile[]

  @@unique([repositoryId, sha])
  @@index([repositoryId, committedAt])
  @@index([authorContributorId, authoredAt])
  @@map("commits")
}

model CommitFile {
  id           String  @id @default(cuid())
  commitId     String  @map("commit_id")
  path         String
  status       String
  additions    Int?
  deletions    Int?
  previousPath String? @map("previous_path")
  commit       Commit  @relation(fields: [commitId], references: [id], onDelete: Cascade)

  @@unique([commitId, path])
  @@map("commit_files")
}

model PushEvent {
  id                    String       @id @default(cuid())
  repositoryId          String       @map("repository_id")
  githubDeliveryId      String       @unique @map("github_delivery_id")
  ref                   String
  beforeSha             String       @map("before_sha") @db.VarChar(64)
  afterSha              String       @map("after_sha") @db.VarChar(64)
  senderContributorId   String?      @map("sender_contributor_id")
  createdAt             DateTime     @default(now()) @map("created_at")
  repository            Repository   @relation(fields: [repositoryId], references: [id], onDelete: Restrict)
  senderContributor     Contributor? @relation(fields: [senderContributorId], references: [id], onDelete: SetNull)

  @@index([repositoryId, createdAt])
  @@map("push_events")
}

model ActivityEvent {
  id            String         @id @default(cuid())
  sourceKey     String         @unique @map("source_key")
  repositoryId  String         @map("repository_id")
  contributorId String?        @map("contributor_id")
  source        ActivitySource
  type          ActivityType
  occurredAt    DateTime       @map("occurred_at")
  metadata      Json
  createdAt     DateTime       @default(now()) @map("created_at")
  repository    Repository     @relation(fields: [repositoryId], references: [id], onDelete: Restrict)
  contributor   Contributor?   @relation(fields: [contributorId], references: [id], onDelete: SetNull)

  @@index([repositoryId, occurredAt])
  @@index([contributorId, occurredAt])
  @@index([source, type, occurredAt])
  @@map("activity_events")
}

model GithubOauthState {
  id               String      @id @default(cuid())
  userId           String      @map("user_id")
  sessionId        String      @map("session_id")
  purpose          String      @default("OAUTH") @db.VarChar(20)
  stateTokenHash   String      @unique @map("state_token_hash")
  intendedRedirect String?     @map("intended_redirect")
  startingGithubUserId BigInt? @map("starting_github_user_id")
  createdAt        DateTime    @default(now()) @map("created_at")
  expiresAt        DateTime    @map("expires_at")
  consumedAt       DateTime?   @map("consumed_at")
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  session          UserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([sessionId, purpose, expiresAt])
  @@map("github_oauth_states")
}

model GithubWebhookDelivery {
  id                   String                   @id @default(cuid())
  githubDeliveryId     String                   @unique @map("github_delivery_id")
  eventName            String                   @map("event_name")
  githubInstallationId BigInt?                  @map("external_installation_id")
  githubRepositoryId   BigInt?                  @map("external_repository_id")
  installationId       String?                  @map("installation_id")
  repositoryId         String?                  @map("repository_id")
  payloadHash          String                   @map("payload_hash")
  payload              Json
  publishedAt          DateTime?                @map("published_at")
  status               WebhookDeliveryStatus    @default(pending)
  receivedAt           DateTime                 @default(now()) @map("received_at")
  processingStartedAt  DateTime?                @map("processing_started_at")
  processedAt          DateTime?                @map("processed_at")
  processingError      String?                  @map("processing_error")
  installation         GithubInstallation?      @relation(fields: [installationId], references: [id], onDelete: SetNull)
  repository           Repository?              @relation(fields: [repositoryId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt, receivedAt])
  @@map("github_webhook_deliveries")
}

model Report {
  id            String        @id @default(cuid())
  userId        String        @map("user_id")
  workspaceId   String?       @map("workspace_id")
  reportDate    DateTime      @map("report_date") @db.Date
  timezone      String        @default("UTC")
  status        ReportStatus  @default(pending)
  inputSnapshot Json          @map("input_snapshot")
  publishedAt  DateTime?      @map("published_at")
  processingToken String?     @map("processing_token")
  processingExpiresAt DateTime? @map("processing_expires_at")
  renderRevision Int?         @map("render_revision")
  renderGeneration Int        @default(0) @map("render_generation")
  renderPublishedAt DateTime? @map("render_published_at")
  currentRevisionId String?   @map("current_revision_id")
  aiOutput      Json?         @map("ai_output")
  latexPath     String?       @map("latex_path")
  pdfPath       String?       @map("pdf_path")
  createdAt     DateTime      @default(now()) @map("created_at")
  completedAt   DateTime?     @map("completed_at")
  error         String?
  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  workspace     Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceOccurrence WorkspaceReportOccurrence?
  revisions     ReportRevision[] @relation("ReportRevisions")
  currentRevision ReportRevision? @relation("CurrentReportRevision", fields: [currentRevisionId], references: [id], onDelete: SetNull)
  artifacts     ReportArtifact[]

  @@index([status, publishedAt, createdAt])
  @@index([status, processingExpiresAt])
  @@index([userId, reportDate, createdAt])
  @@index([workspaceId, createdAt])
  @@map("reports")
}

model ReportRevision {
  id        String               @id @default(cuid())
  reportId  String               @map("report_id")
  revision  Int
  source    ReportRevisionSource
  content   Json
  latexSource String?             @db.Text @map("latex_source")
  createdAt DateTime             @default(now()) @map("created_at")
  report    Report               @relation("ReportRevisions", fields: [reportId], references: [id], onDelete: Cascade)
  currentForReports Report[]      @relation("CurrentReportRevision")
  artifacts ReportArtifact[]

  @@unique([reportId, revision])
  @@unique([id, reportId])
  @@map("report_revisions")
}

model ReportArtifact {
  id         String             @id @default(cuid())
  reportId   String             @map("report_id")
  revisionId String             @map("revision_id")
  kind       ReportArtifactKind
  storageKey String             @unique @map("storage_key")
  sizeBytes  Int                @map("size_bytes")
  checksum   String
  createdAt  DateTime           @default(now()) @map("created_at")
  report     Report             @relation(fields: [reportId], references: [id], onDelete: Cascade)
  revision   ReportRevision     @relation(fields: [revisionId, reportId], references: [id, reportId], onDelete: Restrict)

  @@unique([reportId, revisionId, kind])
  @@index([reportId, createdAt])
  @@map("report_artifacts")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorUserId String?  @map("actor_user_id")
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  requestId  String?  @map("request_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")
  actorUser  User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}
