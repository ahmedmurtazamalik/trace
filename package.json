{
  "name": "trace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "test:integration": "pnpm --filter @trace/database test:integration && pnpm --filter @trace/api test:integration",
    "test:coverage:backend": "pnpm --filter @trace/api test:coverage && pnpm --filter @trace/worker test:coverage",
    "test:latex:docker": "bash -c 'set -euo pipefail; image=trace-latex:candidate-$(git write-tree); docker build --tag \"$image\" infrastructure/latex; RUN_DOCKER_LATEX=1 REPORT_LATEX_TEST_IMAGE=\"$image\" pnpm --filter @trace/worker exec jest --runInBand test/latex/latex-compiler.docker.spec.ts'",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down",
    "db:generate": "pnpm --filter @trace/database db:generate",
    "db:migrate": "pnpm --filter @trace/database db:migrate",
    "db:migrate:dev": "pnpm --filter @trace/database db:migrate:dev",
    "db:seed": "pnpm --filter @trace/database db:seed"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "eslint": "9.35.0",
    "globals": "16.3.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.23",
      "sharp": "0.35.0",
      "vite": "6.4.3"
    },
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "argon2",
      "esbuild",
      "prisma",
      "sharp"
    ]
  }
}
