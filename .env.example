NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://trace:trace_dev_password@localhost:5432/trace?schema=public
REDIS_URL=redis://localhost:6379
SESSION_SECRET=replace-with-at-least-32-random-characters
LOG_LEVEL=info
FRONTEND_ORIGIN=http://localhost:3000
ALLOW_DEMO_SEED=false

GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/api/v1/github/callback
GITHUB_INSTALLATION_CALLBACK_URL=http://localhost:3001/api/v1/github/installation/callback
GITHUB_WEBHOOK_SECRET=

LLM_API_KEY=
REPORT_LLM_PROVIDER=fake
REPORT_LLM_ENDPOINT=
REPORT_LLM_MODEL=
REPORT_PROVIDER_ATTEMPTS=3
REPORT_WORKER_CONCURRENCY=2
WORKER_SHUTDOWN_TIMEOUT_MS=210000
REPORT_LATEX_IMAGE=trace-latex:local
REPORT_LATEX_TIMEOUT_MS=30000
# Production worker containers require an absolute host directory mounted at this exact path.
REPORT_LATEX_WORK_ROOT=
REPORT_STORAGE_DRIVER=filesystem
# Must point to a persistent, shared volume in production.
REPORT_STORAGE_ROOT=/tmp/trace-report-artifacts

STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
